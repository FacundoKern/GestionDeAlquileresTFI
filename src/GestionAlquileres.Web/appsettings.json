{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Empresa": {
    "Logo": "img/logo.png",
    "LogoSobreOscuro": "img/logo-claro.png",
    "Icono": "img/favicon-32.png",
    "IconoApple": "img/apple-touch-icon.png"
  },
  "BaseDeDatos": {
    "InicializarAlIniciar": true,
    "AplicarMigracionesAlIniciar": false
  },
  "Seed": {
    "DatosDePrueba": false,
    "Usuarios": {}
  },
  "Fotos": {
    "Carpeta": "App_Data/fotos",
    "MaximoPorPropiedad": 30,
    "MaximoPorEnvio": 10,
    "TamanioMaximoMB": 10
  },
  "Semaforo": {
    "DiasContratoPorVencer": 60,
    "DiasPagoProximo": 5,
    "DiasProximoAjuste": 30
  }
}
