<?xml version="1.0" encoding="utf-8"?>
<!--
  Solo para publicar en IIS. dotnet publish completa la sección aspNetCore.
  IIS tiene su propio límite de pedido (30 MB por defecto), que corta la subida de fotos antes de que llegue a la
  aplicación: se sube a 120 MB, igual que LimiteSubida en FotosPropiedadesController.
  No lleva secretos: la cadena de conexión y las contraseñas van en variables de entorno del panel del hosting.
-->
<configuration>
  <system.webServer>
    <security>
      <requestFiltering>
        <requestLimits maxAllowedContentLength="125829120" />
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>
