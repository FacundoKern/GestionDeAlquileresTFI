@model GestionAlquileres.Web.ViewModels.Inquilinos.InquilinosIndexViewModel
@{
    ViewData["Title"] = "Inquilinos";
    var puedeGestionar = (await AuthorizationService.AuthorizeAsync(User, Politicas.Gestion)).Succeeded;
    var filtro = Model.Filtro;
    var hayFiltros = !string.IsNullOrWhiteSpace(filtro.Texto)
        || (Model.MostrarContratos && (!string.IsNullOrWhiteSpace(filtro.Propiedad) || filtro.ConContratoVigente is not null));
}

@section Acciones {
    @if (puedeGestionar)
    {
        <a asp-action="Crear" class="btn btn-primary"><i class="bi bi-plus-lg" aria-hidden="true"></i> Nuevo inquilino</a>
    }
}

<section class="card mb-4" aria-labelledby="titulo-busqueda">
    <div class="card-body">
        <h2 id="titulo-busqueda" class="h6 card-title">Buscar</h2>
        <form asp-action="Index" method="get" role="search" class="row g-3 align-items-end">
            <div class="col-md-6 @(Model.MostrarContratos ? "col-xl-4" : "col-xl-5")">
                <label for="Texto" class="form-label">Nombre o documento</label>
                <input id="Texto" name="Texto" value="@filtro.Texto" class="form-control" type="search" />
            </div>
            @if (Model.MostrarContratos)
            {
                <div class="col-md-6 col-xl-3">
                    <label for="Propiedad" class="form-label">Propiedad (calle o localidad)</label>
                    <input id="Propiedad" name="Propiedad" value="@filtro.Propiedad" class="form-control" type="search" />
                </div>
                <div class="col-md-6 col-xl-3">
                    <label for="ConContratoVigente" class="form-label">Contrato</label>
                    <select id="ConContratoVigente" name="ConContratoVigente" class="form-select">
                        <option value="">Todos</option>
                        <option value="true" selected="@(filtro.ConContratoVigente == true)">Con contrato vigente</option>
                        <option value="false" selected="@(filtro.ConContratoVigente == false)">Sin contrato vigente</option>
                    </select>
                </div>
            }
            <div class="col-md-6 col-xl-2 d-flex gap-2">
                <button type="submit" class="btn btn-primary"><i class="bi bi-search" aria-hidden="true"></i> Buscar</button>
                @if (hayFiltros)
                {
                    <a asp-action="Index" class="btn btn-outline-secondary">Limpiar</a>
                }
            </div>
        </form>
    </div>
</section>

<section class="card" aria-labelledby="titulo-resultados">
    <div class="card-body">
        <h2 id="titulo-resultados" class="h6 card-title">@(hayFiltros ? "Resultados de la búsqueda" : "Todos los inquilinos")</h2>

        @if (Model.Resultados.TotalRegistros == 0)
        {
            <p class="mb-0">@(hayFiltros ? "No se encontraron inquilinos con esos filtros." : "Todavía no hay inquilinos cargados.")</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <caption class="visually-hidden">Listado de inquilinos</caption>
                    <thead>
                        <tr>
                            <th scope="col">Nombre</th>
                            <th scope="col">Documento</th>
                            <th scope="col">Teléfono</th>
                            @if (Model.MostrarContratos)
                            {
                                <th scope="col">Propiedad</th>
                                <th scope="col">Contrato</th>
                                <th scope="col">Estado</th>
                            }
                            else
                            {
                                <th scope="col">Email</th>
                            }
                            <th scope="col"><span class="visually-hidden">Acciones</span></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var i in Model.Resultados.Items)
                        {
                            <tr>
                                <th scope="row" class="fw-normal"><a asp-action="Detalle" asp-route-id="@i.Id">@i.Nombre</a></th>
                                <td class="text-nowrap">@i.Documento</td>
                                <td class="text-nowrap">@(i.Telefono ?? "—")</td>
                                @if (Model.MostrarContratos)
                                {
                                    if (i.Contrato is { } contrato)
                                    {
                                        <td>
                                            <a asp-controller="Propiedades" asp-action="Detalle" asp-route-id="@contrato.PropiedadId">@contrato.Propiedad</a>
                                            @if (i.OtrosContratos > 0)
                                            {
                                                <div class="small text-body-secondary">y @i.OtrosContratos @(i.OtrosContratos == 1 ? "contrato" : "contratos") más</div>
                                            }
                                        </td>
                                        <td class="text-nowrap">@Formato.Fecha(contrato.FechaInicio) al @Formato.Fecha(contrato.FechaFin)</td>
                                        <td><partial name="_Semaforo" model="contrato.Estado" /></td>
                                    }
                                    else
                                    {
                                        <td colspan="3" class="text-body-secondary">Sin contratos</td>
                                    }
                                }
                                else
                                {
                                    <td>@(i.Email ?? "—")</td>
                                }
                                <td class="text-end text-nowrap">
                                    @if (puedeGestionar)
                                    {
                                        <a asp-action="Editar" asp-route-id="@i.Id" class="btn btn-outline-primary btn-sm">
                                            <i class="bi bi-pencil" aria-hidden="true"></i> Editar<span class="visually-hidden"> a @i.Nombre</span>
                                        </a>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <partial name="_Paginacion" model="@(new PaginacionViewModel(Model.Resultados.Pagina, Model.Resultados.TotalPaginas, Model.Resultados.TotalRegistros, new Dictionary<string, string?> { ["Texto"] = filtro.Texto, ["Propiedad"] = filtro.Propiedad, ["ConContratoVigente"] = filtro.ConContratoVigente?.ToString().ToLowerInvariant() }))" />
        }
    </div>
</section>
