@model GestionAlquileres.Web.ViewModels.Garantes.GaranteDetalleViewModel
@{
    ViewData["Title"] = Model.Datos.NombreCompleto;
    ViewData.EstablecerMigas(new Miga("Garantes", Url.Action("Index")!));
    var puedeGestionar = (await AuthorizationService.AuthorizeAsync(User, Politicas.Gestion)).Succeeded;
}

@section Acciones {
    @*
        TODO (junto con los PDF de fase 3): botón "Descargar ficha en PDF" (QuestPDF), para todos los roles.
        Mismo contenido que la ficha del propietario: encabezado con datos de la inmobiliaria y fecha; datos del
        garante (sin notas internas); contratos que garantiza con tipo de garantía y estado en texto; pie con
        número de página. Enmascarado para Consulta y descarga auditada.
    *@
    @if (puedeGestionar)
    {
        <a asp-action="Editar" asp-route-id="@Model.Id" class="btn btn-primary"><i class="bi bi-pencil" aria-hidden="true"></i> Editar</a>
        <a asp-action="Eliminar" asp-route-id="@Model.Id" class="btn btn-outline-danger"><i class="bi bi-trash" aria-hidden="true"></i> Eliminar</a>
    }
}

<partial name="_DatosPersona" model="Model.Datos" />

@if (Model.Contratos is { } contratos)
{
    <section class="card mb-4" aria-labelledby="titulo-contratos">
        <div class="card-body">
            <h2 id="titulo-contratos" class="h5 card-title">Contratos que garantiza</h2>
            @if (contratos.Count == 0)
            {
                <p class="mb-0">No figura como garante de ningún contrato.</p>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table align-middle mb-0">
                        <caption class="visually-hidden">Contratos que garantiza, vigentes primero</caption>
                        <thead>
                            <tr>
                                <th scope="col">Propiedad</th>
                                <th scope="col">Inquilinos</th>
                                <th scope="col">Vigencia</th>
                                <th scope="col">Garantía</th>
                                <th scope="col">Estado</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in contratos)
                            {
                                <tr>
                                    <td><a asp-controller="Propiedades" asp-action="Detalle" asp-route-id="@item.Contrato.PropiedadId">@item.Contrato.Propiedad</a></td>
                                    <td>@item.Contrato.Inquilinos</td>
                                    <td class="text-nowrap">@Formato.Fecha(item.Contrato.FechaInicio) al @Formato.Fecha(item.Contrato.FechaFin)</td>
                                    <td>
                                        @item.TipoGarantia.Nombre()
                                        @if (!string.IsNullOrWhiteSpace(item.DetalleGarantia))
                                        {
                                            <div class="small text-body-secondary">@item.DetalleGarantia</div>
                                        }
                                    </td>
                                    <td><partial name="_Semaforo" model="item.Contrato.Estado" /></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </section>
}
else
{
    <partial name="_ContratosNoDisponibles" />
}
