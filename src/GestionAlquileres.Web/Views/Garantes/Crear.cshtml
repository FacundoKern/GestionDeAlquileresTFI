@model GestionAlquileres.Web.ViewModels.Garantes.GaranteFormViewModel
@{
    ViewData["Title"] = "Nuevo garante";
    ViewData.EstablecerMigas(new Miga("Garantes", Url.Action("Index")!));
}

<partial name="_ResumenErrores" />

<form asp-action="Crear" method="post" novalidate class="card">
    <div class="card-body">
        <partial name="_CamposPersona" model="Model" />
        <div class="d-flex flex-wrap gap-2">
            <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg" aria-hidden="true"></i> Guardar garante</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
        </div>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
