@model GestionAlquileres.Web.ViewModels.Propiedades.PropiedadFormViewModel
@{
    ViewData["Title"] = "Editar propiedad";
    var direccion = GestionAlquileres.Web.Models.Entidades.Propiedad.FormatearDireccion(Model.Calle, Model.Numero, Model.Piso, Model.Departamento, Model.Localidad);
    ViewData.EstablecerMigas(
        new Miga("Propiedades", Url.Action("Index")!),
        new Miga(direccion, Url.Action("Detalle", new { id = Model.Id })!));
}

<partial name="_ResumenErrores" />

<form asp-action="Editar" asp-route-id="@Model.Id" method="post" novalidate class="card">
    <input type="hidden" asp-for="RowVersion" />
    <div class="card-body">
        <partial name="_Formulario" model="Model" />
        <div class="d-flex flex-wrap gap-2">
            <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg" aria-hidden="true"></i> Guardar cambios</button>
            <a asp-action="Detalle" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Cancelar</a>
        </div>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
