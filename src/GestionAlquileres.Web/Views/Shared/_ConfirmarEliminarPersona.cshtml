@model GestionAlquileres.Web.ViewModels.Personas.EliminarPersonaViewModel
@*
    Confirmación de borrado (sin JavaScript: es una página propia, accesible con teclado y lector de pantalla).
    ViewData["Entidad"]: "propietario", "inquilino" o "garante".
*@
@{
    var entidad = ViewData["Entidad"] as string ?? "registro";
}

<div class="card">
    <div class="card-body">
        @if (Model.MotivoNoSePuede is { } motivo)
        {
            <div class="alert alert-warning" role="alert">
                <i class="bi bi-exclamation-triangle" aria-hidden="true"></i> @motivo
            </div>
            <a asp-action="Detalle" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Volver a la ficha</a>
        }
        else
        {
            <p class="fs-5">¿Querés eliminar al @entidad <strong>@Model.NombreCompleto</strong> (@Model.Documento)?</p>
            <p>Dejará de aparecer en los listados y búsquedas. Sus datos quedan guardados en el historial y en la auditoría.</p>

            <form asp-action="Eliminar" asp-route-id="@Model.Id" method="post" class="d-flex flex-wrap gap-2">
                <input type="hidden" name="rowVersion" value="@Model.RowVersion" />
                <button type="submit" class="btn btn-danger">
                    <i class="bi bi-trash" aria-hidden="true"></i> Sí, eliminar @entidad
                </button>
                <a asp-action="Detalle" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Cancelar</a>
            </form>
        }
    </div>
</div>
